# API base — Vite dev proxy forwards /api → jpg-adapter (:8001)
VITE_API_BASE_URL=/api

# LogicalDOC sign-in link (logout / session-required page)
# VITE_LOGICALDOC_BASE_URL=https://ld.rag.jysim.net

# Chat auth bypass (local dev only)
# VITE_AUTH_BYPASS=true

# Admin dashboard — must match ADAPTER_QUERY_API_KEY on jpg-adapter (omit in dev if adapter key unset)
# VITE_ADMIN_API_KEY=
# VITE_ADMIN_API_KEY_HEADER=X-Adapter-Query-Key

# Admin dashboard mock mode — serves the whole admin dashboard from an
# in-memory mock (src/mocks/adminMockApi.ts) with zero backend. Great for
# UI-only work; simulates a live bulk crawl, failures, retries, pause/resume.
# VITE_ADMIN_MOCK=true

# Sidebar indexing-status auto-refresh interval, in seconds (default 15; 0 disables polling)
# VITE_BROWSE_REFRESH_SECONDS=15

# Folder/Category browse toggle, category select, and CategoryTag chips —
# build-time flag, OFF by default (client asked for it hidden; code stays
# in place). Set to 'true' to turn it back on; requires a rebuild.
# VITE_FEATURE_CATEGORY_VIEW=true
